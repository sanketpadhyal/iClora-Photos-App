{
  "expo": {
    "name": "iClora",
    "slug": "iclora-sync",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "iclora",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content",
      "translucent": false
    },
    "icon": "./assets/app-icon.jpeg",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "assets/*"
    ],
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "iClora needs photo library access to auto-sync your gallery photos to your private cloud.",
          "savePhotosPermission": "iClora needs permission to save downloaded cloud photos back to your device.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon-foreground.png",
          "color": "#0f71f2",
          "sounds": [
            "./assets/notification_sound.mp3"
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-web-browser"
    ],
    "android": {
      "package": "app.iclora.android",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.iclora.android"
    }
  }
}
